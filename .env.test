# ---- Test environment ----
# Loaded by vitest (vitest.setup.ts) and vitest.global-setup.ts.
# Keeps test runs isolated from the dev database (foodiebus).

NODE_ENV=test
LOG_LEVEL=silent
# Dedicated test database — never point this at the dev DB.
DATABASE_URL=postgresql://foodiebus:foodiebus_dev@localhost:5432/foodiebus_test?schema=public
REDIS_URL=redis://localhost:6379
# Test-only secrets (never used in production).
JWT_ACCESS_SECRET=test_access_secret_with_at_least_32_chars_0000
JWT_REFRESH_SECRET=test_refresh_secret_with_at_least_32_chars_0000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PAYCHANGU_SECRET_KEY=test_paychangu_secret_key
PAYCHANGU_PUBLIC_KEY=test_paychangu_public_key
PAYCHANGU_WEBHOOK_SECRET=test_paychangu_webhook_secret
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_CALLBACK_URL=http://localhost:8080/api/v1/webhooks/paychangu
PAYCHANGU_RETURN_URL=http://localhost:8080
# Test storage — always mock, never touch a real bucket.
STORAGE_PROVIDER=mock
STORAGE_UPLOAD_DIR=./uploads-test
RATE_LIMIT_ENABLED=false
