generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCIAL
  VENDOR
  OPERATOR
  DRIVER
  STUDENT
}

enum RatingEntityType {
  TRIP
  DISH
  OPERATOR
  VENDOR
}

enum DriverPayoutStatus {
  PENDING
  PAID
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponApplicableTo {
  TRIP
  FOOD
  BOTH
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  fullName     String
  profileImage String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  vendorProfile          VendorProfile?
  operatorProfile        OperatorProfile?
  driverProfile          DriverProfile?
  bookings               Booking[]
  notifications          Notification[]
  otpCodes               OtpCode[]
  notificationPreference NotificationPreference?
  refundsRequested       Refund[]                @relation("RefundRequestedBy")
  refundsApproved        Refund[]                @relation("RefundApprovedBy")
  foodOrders             FoodOrder[]
  ratings                Rating[]
  couponUsages           CouponUsage[]
  favorites              Favorite[]
  deviceTokens           DeviceToken[]

  @@index([role])
  @@index([deletedAt])
}

model FoodCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dishes Dish[]

  @@index([isActive])
}

model VendorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  description  String?
  phone        String?
  logoUrl      String?
  bannerUrl    String?
  cuisineType  String?
  deliveryTime Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dishes      Dish[]
  settlements Settlement[]
  foodOrders  FoodOrder[]
  favorites   Favorite[]

  @@index([isActive])
}

model Dish {
  id            String        @id @default(uuid())
  vendorId      String
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId    String
  category      FoodCategory  @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  imageUrl      String?
  isAvailable   Boolean       @default(true)
  availableFrom DateTime?
  availableTo   DateTime?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  foodOrderItems FoodOrderItem[]
  favorites      Favorite[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([vendorId, isAvailable])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum BusType {
  STANDARD
  VIP
  EXECUTIVE
}

enum TripStatus {
  SCHEDULED
  BOARDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model OperatorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  description   String?
  phone         String?
  logoUrl       String?
  licenseNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buses       Bus[]
  trips       Trip[]
  settlements Settlement[]
  drivers     DriverProfile[]

  @@index([isActive])
}

model Bus {
  id          String          @id @default(uuid())
  operatorId  String
  operator    OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name        String
  plateNumber String          @unique
  capacity    Int
  busType     BusType         @default(STANDARD)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trips Trip[]

  @@index([operatorId])
  @@index([isActive])
}

model Route {
  id         String   @id @default(uuid())
  fromCity   String
  toCity     String
  basePrice  Decimal  @db.Decimal(10, 2)
  distanceKm Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trips Trip[]
  stops RouteStop[]

  @@unique([fromCity, toCity])
  @@index([fromCity])
  @@index([toCity])
  @@index([isActive])
}

model RouteStop {
  id                     String   @id @default(uuid())
  routeId                String
  route                  Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order                  Int
  city                   String
  departureOffsetMinutes Int
  segmentPrice           Decimal  @db.Decimal(10, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bookingsAsOrigin      Booking[] @relation("BookingOriginStop")
  bookingsAsDestination Booking[] @relation("BookingDestinationStop")

  @@unique([routeId, order])
  @@index([routeId])
}

model Trip {
  id            String          @id @default(uuid())
  operatorId    String
  operator      OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  routeId       String
  route         Route           @relation(fields: [routeId], references: [id])
  busId         String
  bus           Bus             @relation(fields: [busId], references: [id])
  driverId      String?
  driver        DriverProfile?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  departureTime DateTime
  arrivalTime   DateTime
  price         Decimal         @db.Decimal(10, 2)
  status        TripStatus      @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  seats      SeatInventory[]
  bookings   Booking[]
  foodOrders FoodOrder[]
  payout     DriverTripPayout?

  @@index([operatorId])
  @@index([routeId])
  @@index([departureTime])
  @@index([status])
}

model SeatInventory {
  id         String     @id @default(uuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings Booking[]

  @@unique([tripId, seatNumber])
  @@index([tripId, status])
}

model Booking {
  id                   String        @id @default(uuid())
  tripId               String
  trip                 Trip          @relation(fields: [tripId], references: [id])
  seatId               String
  seat                 SeatInventory @relation(fields: [seatId], references: [id])
  passengerId          String
  passenger            User          @relation(fields: [passengerId], references: [id])
  passengerName        String
  passengerPhone       String
  status               BookingStatus @default(PENDING)
  totalAmount          Decimal       @db.Decimal(10, 2)
  couponCode           String?
  discountAmount       Decimal       @default(0) @db.Decimal(10, 2)
  originStopId         String?
  originStop           RouteStop?    @relation("BookingOriginStop", fields: [originStopId], references: [id])
  destinationStopId    String?
  destinationStop      RouteStop?    @relation("BookingDestinationStop", fields: [destinationStopId], references: [id])
  originStopOrder      Int?
  destinationStopOrder Int?
  checkedInAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payments   Payment[]
  foodOrders FoodOrder[]

  @@index([tripId])
  @@index([passengerId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Currency {
  MWK
  USD
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum SettlementStatus {
  PENDING
  PAID
}

model Payment {
  id                 String        @id @default(uuid())
  bookingId          String
  booking            Booking       @relation(fields: [bookingId], references: [id])
  txRef              String        @unique
  amount             Decimal       @db.Decimal(10, 2)
  currency           Currency      @default(MWK)
  status             PaymentStatus @default(PENDING)
  channel            String?
  provider           String?
  charges            Decimal?      @db.Decimal(10, 2)
  checkoutUrl        String?
  paychanguReference String?
  meta               Json?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  refunds       Refund[]
  mismatches    ReconciliationMismatch[]
  webhookEvents WebhookEvent[]

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  txRef     String
  event     String
  status    String
  payload   Json
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [txRef], references: [txRef], onDelete: Cascade)

  @@unique([txRef, event])
  @@index([txRef])
}

model ReconciliationMismatch {
  id           String    @id @default(uuid())
  paymentId    String
  payment      Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  localStatus  String
  remoteStatus String
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([resolved])
  @@index([createdAt])
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model Notification {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  subject       String?
  body          String
  status        NotificationStatus  @default(PENDING)
  reference     String?
  referenceType String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([referenceType, reference])
  @@index([status])
}

model OtpCode {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  purpose     String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())

  @@index([userId, purpose])
}

enum DevicePlatform {
  ANDROID
  IOS
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  DevicePlatform @default(ANDROID)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@index([isActive])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sms       Boolean  @default(true)
  whatsapp  Boolean  @default(true)
  email     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id])
  amount            Decimal      @db.Decimal(10, 2)
  reason            String
  status            RefundStatus @default(REQUESTED)
  requestedById     String
  requestedBy       User         @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?        @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  processedAt       DateTime?
  paychanguRefundId String?
  failureReason     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model Settlement {
  id             String           @id @default(uuid())
  operatorId     String?
  operator       OperatorProfile? @relation(fields: [operatorId], references: [id])
  vendorId       String?
  vendor         VendorProfile?   @relation(fields: [vendorId], references: [id])
  period         String
  grossRevenue   Decimal          @db.Decimal(12, 2)
  commissionRate Decimal          @db.Decimal(5, 4)
  commissionAmt  Decimal          @db.Decimal(12, 2)
  netPayout      Decimal          @db.Decimal(12, 2)
  status         SettlementStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([operatorId, period])
  @@unique([vendorId, period])
  @@index([status])
  @@index([period])
}

enum FoodOrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED_TO_BUS
  CANCELLED
}

model DriverProfile {
  id            String          @id @default(uuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatorId    String
  operator      OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  licenseNumber String?
  phone         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  trips   Trip[]
  payouts DriverTripPayout[]

  @@index([operatorId])
  @@index([isActive])
}

model FoodOrder {
  id             String          @id @default(uuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id])
  passengerId    String
  passenger      User            @relation(fields: [passengerId], references: [id])
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id])
  vendorId       String
  vendor         VendorProfile   @relation(fields: [vendorId], references: [id])
  status         FoodOrderStatus @default(PLACED)
  totalAmount    Decimal         @db.Decimal(10, 2)
  couponCode     String?
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items FoodOrderItem[]

  @@index([bookingId])
  @@index([tripId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model FoodOrderItem {
  id          String    @id @default(uuid())
  foodOrderId String
  foodOrder   FoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  dishId      String
  dish        Dish      @relation(fields: [dishId], references: [id])
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([foodOrderId])
  @@index([dishId])
}

model Rating {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType RatingEntityType
  entityId   String
  score      Int
  comment    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

model DriverTripPayout {
  id        String             @id @default(uuid())
  driverId  String
  driver    DriverProfile      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId    String             @unique
  trip      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  amount    Decimal            @db.Decimal(10, 2)
  status    DriverPayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([driverId, tripId])
  @@index([driverId])
  @@index([status])
}

model Coupon {
  id           String             @id @default(uuid())
  code         String             @unique
  type         CouponType
  value        Decimal            @db.Decimal(10, 2)
  maxUses      Int                @default(0)
  perUserUses  Int                @default(1)
  validFrom    DateTime
  validTo      DateTime
  applicableTo CouponApplicableTo @default(BOTH)
  minSpend     Decimal?           @db.Decimal(10, 2)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  usages CouponUsage[]

  @@index([applicableTo])
  @@index([isActive])
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextType    String
  contextId      String
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([couponId, userId, contextType, contextId])
  @@index([userId])
  @@index([contextType, contextId])
}

model Favorite {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId    String?
  dish      Dish?          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  vendorId  String?
  vendor    VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([userId])
}
