# ---- Core ----
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ---- Database ----
# Local Docker Compose default
DATABASE_URL=postgresql://foodiebus:foodiebus_dev@localhost:5432/foodiebus?schema=public

# Tests use a SEPARATE database — see .env.test (loaded automatically by vitest).
# Create it once locally with: createdb -O foodiebus foodiebus_test
#   or run: npm run db:test:setup

# ---- Redis / Queue ----
REDIS_URL=redis://localhost:6379

# ---- Notifications ----
BOOKING_HOLD_MINUTES=15
OTP_TTL_MINUTES=10
# SMS: mock | africastalking
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_USERNAME=
SMS_SENDER_ID=FoodieBus
# WhatsApp: mock | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Email: mock | resend | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@foodiebus.mw
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Push: mock | fcm | apns
PUSH_PROVIDER=mock
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.foodiebus.app

# ---- Auth ----
# Generate with: openssl rand -hex 32  (the app refuses to start with the placeholder below)
JWT_ACCESS_SECRET=change_me_generate_a_long_random_secret_48_chars_min
JWT_REFRESH_SECRET=change_me_generate_a_different_long_random_secret_48_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Bootstrap super admin (run: npm run bootstrap:super-admin) ----
SUPER_ADMIN_EMAIL=admin@foodiebus.mw
SUPER_ADMIN_PASSWORD=change_me_strong_password
SUPER_ADMIN_PHONE=+265991000000
SUPER_ADMIN_NAME=Super Admin

# ---- PayChangu ----
PAYCHANGU_SECRET_KEY=
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_BASE_URL=https://api.paychangu.com

# ---- Financial ----
# Default commission rate for operator/vendor settlements (0.10 = 10%).
# Overridable at runtime via the PlatformSetting "commission_rate".
COMMISSION_RATE=0.10

# ---- Error tracking ----
SENTRY_DSN=

# ---- Storage ----
# Object storage for media uploads (dish images, vendor/operator logos).
# STORAGE_PROVIDER: mock | s3
#   mock — writes to a local dir (STORAGE_UPLOAD_DIR) and serves it via @fastify/static
#   s3   — streams to an S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces)
STORAGE_PROVIDER=mock
STORAGE_UPLOAD_DIR=./uploads
STORAGE_S3_BUCKET=foodiebus-uploads
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=          # optional — S3-compatible endpoint (R2, DO Spaces, MinIO)
STORAGE_S3_PUBLIC_BASE_URL=   # optional — CDN/bucket public URL prefix
STORAGE_MAX_SIZE_MB=5
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ---- Driver payouts ----
# Flat fee credited to a driver when an assigned trip reaches COMPLETED.
# Overridable at runtime via the PlatformSetting "driver_trip_fee".
DRIVER_TRIP_FEE=0
